{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CS5351 requirements registry schema",
  "type": "object",
  "required": ["version", "scope", "requirements"],
  "additionalProperties": false,
  "properties": {
    "version": {"type": "integer", "minimum": 1},
    "scope": {"type": "string", "minLength": 1},
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "type", "priority", "problem", "statement", "acceptance", "implementation"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^R[1-9][0-9]*$"},
          "title": {"type": "string", "minLength": 1},
          "type": {"enum": ["functional", "invariant", "quality", "performance", "cost", "governance", "safety"]},
          "priority": {"enum": ["Must", "Should", "Could", "Won't"]},
          "problem": {"type": "string", "minLength": 1},
          "statement": {"type": "string", "minLength": 1},
          "assumptions": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "acceptance": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "criterion", "evidence"],
              "additionalProperties": false,
              "properties": {
                "id": {"type": "string", "pattern": "^R[1-9][0-9]*-A[1-9][0-9]*$"},
                "criterion": {"type": "string", "minLength": 1},
                "evidence": {
                  "type": "array",
                  "minItems": 1,
                  "items": {"type": "string", "minLength": 1}
                }
              }
            }
          },
          "implementation": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
        }
      }
    }
  }
}
