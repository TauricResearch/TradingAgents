{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "traders.schema.json",
  "title": "Trader profile",
  "description": "One elite-trader knowledge-base record. Honesty contract: null means 'not disclosed' and is a correct, minable answer — never coerce to 0 or guess. Every non-null quantitative value carries provenance via the sourced-value pattern. Vocabulary strings must come from vocabularies.json (same directory, versioned).",
  "type": "object",
  "required": [
    "id", "name", "cohort", "status", "verification",
    "style", "entry", "exit", "risk", "sizing",
    "psychology_rules", "performance", "extraction"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$",
      "description": "Stable slug, e.g. 'ed_seykota'."
    },
    "name": { "type": "string", "minLength": 1 },
    "aliases": { "type": "array", "items": { "type": "string" } },
    "born_era": {
      "type": ["string", "null"],
      "description": "Decade, e.g. '1940s'; null if unknown."
    },
    "status": { "$ref": "#/$defs/vocab" },
    "cohort": { "$ref": "#/$defs/vocab" },
    "verification": {
      "type": "object",
      "required": ["tier", "tier_justification", "sources"],
      "additionalProperties": false,
      "properties": {
        "tier": {
          "enum": ["A", "B", "C"],
          "description": "A = audited/regulatory/exchange-verified track record. B = documented in reputable published secondary sources (Schwager-class books, biographies, academic papers). C = self-reported only (interviews, podcasts, social media) — retained but flagged."
        },
        "tier_justification": { "type": "string", "minLength": 10 },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/source" }
        }
      }
    },
    "style": {
      "type": "object",
      "required": ["primary", "discretion", "markets", "timeframes", "typical_holding_period"],
      "additionalProperties": false,
      "properties": {
        "primary": { "$ref": "#/$defs/vocab" },
        "secondary": { "type": "array", "items": { "$ref": "#/$defs/vocab" } },
        "discretion": { "$ref": "#/$defs/vocab" },
        "markets": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/vocab" } },
        "timeframes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/vocab" } },
        "typical_holding_period": { "$ref": "#/$defs/vocab" }
      }
    },
    "entry": {
      "type": "object",
      "required": ["archetypes", "trigger_summary", "confirmation", "filters"],
      "additionalProperties": false,
      "properties": {
        "archetypes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/vocab" } },
        "trigger_summary": {
          "type": ["string", "null"],
          "description": "PARAPHRASED description of the entry trigger, with the supporting source cited in notes or sources. Never verbatim copyrighted text."
        },
        "confirmation": { "type": "array", "items": { "$ref": "#/$defs/vocab" } },
        "filters": { "type": "array", "items": { "$ref": "#/$defs/vocab" } },
        "notes": { "type": ["string", "null"] }
      }
    },
    "exit": {
      "type": "object",
      "required": ["initial_stop_basis", "uses_trailing", "profit_taking", "scales_out", "time_exit"],
      "additionalProperties": false,
      "properties": {
        "initial_stop_basis": { "$ref": "#/$defs/vocab" },
        "uses_trailing": { "type": ["boolean", "null"] },
        "profit_taking": { "type": "array", "items": { "$ref": "#/$defs/vocab" } },
        "scales_out": { "type": ["boolean", "null"] },
        "time_exit": { "type": ["boolean", "null"] },
        "notes": { "type": ["string", "null"] }
      }
    },
    "risk": {
      "type": "object",
      "required": ["risk_per_trade_pct", "max_drawdown_rule", "loss_limit", "pyramids", "moves_to_breakeven", "portfolio_heat_cap"],
      "additionalProperties": false,
      "properties": {
        "risk_per_trade_pct": { "$ref": "#/$defs/sourced_value_or_null" },
        "max_drawdown_rule": { "$ref": "#/$defs/sourced_value_or_null" },
        "loss_limit": {
          "$ref": "#/$defs/sourced_value_or_null",
          "description": "Daily/weekly/monthly loss limit; period goes in the unit field, e.g. 'pct_equity_daily'."
        },
        "pyramids": { "type": ["boolean", "null"] },
        "moves_to_breakeven": { "type": ["boolean", "null"] },
        "portfolio_heat_cap": { "$ref": "#/$defs/sourced_value_or_null" },
        "notes": { "type": ["string", "null"] }
      }
    },
    "sizing": {
      "type": "object",
      "required": ["model"],
      "additionalProperties": false,
      "properties": {
        "model": { "$ref": "#/$defs/vocab" },
        "typical_leverage": { "$ref": "#/$defs/sourced_value_or_null" },
        "notes": { "type": ["string", "null"] }
      }
    },
    "psychology_rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["rule", "paraphrase", "source_idx"],
        "additionalProperties": false,
        "properties": {
          "rule": { "$ref": "#/$defs/vocab" },
          "paraphrase": { "type": "string", "minLength": 1 },
          "source_idx": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "performance": {
      "type": "object",
      "required": ["claims"],
      "additionalProperties": false,
      "properties": {
        "claims": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["metric", "value", "period", "verification", "source_idx"],
            "additionalProperties": false,
            "properties": {
              "metric": { "$ref": "#/$defs/vocab" },
              "value": { "type": "number" },
              "unit": { "type": ["string", "null"] },
              "period": {
                "type": "string",
                "description": "E.g. '1972-1988', 'career', '2020'. Required — a number without a period is not a claim."
              },
              "verification": { "enum": ["audited", "reported", "anecdotal"] },
              "source_idx": { "type": "integer", "minimum": 0 },
              "note": { "type": ["string", "null"] }
            }
          }
        }
      }
    },
    "caution_flags": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Disputed track records, later blow-ups, regulatory actions, debunked claims — recorded, never laundered. E.g. 'niederhoffer_1997_blowup', 'track_record_disputed'."
    },
    "extraction": {
      "type": "object",
      "required": ["batch_id", "date", "qa_reviewed"],
      "additionalProperties": false,
      "properties": {
        "batch_id": { "type": "string" },
        "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "agent_notes": { "type": ["string", "null"] },
        "qa_reviewed": { "type": "boolean" },
        "qa_notes": { "type": ["string", "null"] }
      }
    }
  },
  "$defs": {
    "vocab": {
      "type": "string",
      "description": "Must be a member of the corresponding list in vocabularies.json — enforced by analyze_traders.py --validate (JSON Schema alone cannot cross-reference the versioned vocab file)."
    },
    "source": {
      "type": "object",
      "required": ["title", "type", "year"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "author": { "type": ["string", "null"] },
        "year": { "type": ["integer", "null"] },
        "type": { "$ref": "#/$defs/vocab" },
        "url": { "type": ["string", "null"] },
        "locator": {
          "type": ["string", "null"],
          "description": "Chapter/page/timestamp helping a human re-find the claim."
        },
        "accessed": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
      }
    },
    "sourced_value_or_null": {
      "description": "A quantitative claim with provenance, or null (= not disclosed). basis 'disclosed' = the trader/source states the number; 'inferred' = derived from stated facts (say how in note).",
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["value", "unit", "basis", "source_idx"],
          "additionalProperties": false,
          "properties": {
            "value": { "type": "number" },
            "unit": { "type": "string", "minLength": 1 },
            "basis": { "enum": ["disclosed", "inferred"] },
            "source_idx": { "type": "integer", "minimum": 0 },
            "note": { "type": ["string", "null"] }
          }
        }
      ]
    }
  }
}
