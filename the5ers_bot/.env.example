# Copy to .env and fill in:  cp .env.example .env
# NEVER commit the resulting .env file.

# --- MetaApi credentials --------------------------------------------------- #
METAAPI_TOKEN=your-metaapi-token
METAAPI_ACCOUNT_ID=
METAAPI_PLATFORM=mt5
# METAAPI_REGION=new-york

# --- Raw MT5 credentials (only if METAAPI_ACCOUNT_ID is empty) ------------- #
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=The5ers-Live
MT5_MAGIC=520052

# --- Instruments / strategy ------------------------------------------------ #
TRADING_SYMBOLS=BTCUSD,ETHUSD
SYMBOL_SUFFIX=
STRATEGY_TIMEFRAME=15m
CANDLE_LIMIT=200
POLL_INTERVAL_SECONDS=60

EMA_FAST=21
EMA_SLOW=55
RSI_PERIOD=14
RSI_LONG_MIN=52
RSI_SHORT_MAX=48
ATR_PERIOD=14
ATR_STOP_MULTIPLIER=2.0
REWARD_RISK=3.0
# Strict minimum 1:3 - any smaller value is clamped up to 1:3 at runtime.
RISK_PER_TRADE_PCT=0.5
MAX_OPEN_POSITIONS=2

# --- Triple-Lock kill switch ----------------------------------------------- #
DAILY_PROFIT_TARGET=60
DAILY_MAX_LOSS=100
# IANA timezone for the daily P&L baseline rollover. Set this to your MetaTrader
# server's timezone so the reset matches the broker's trading day, not UTC.
DAILY_RESET_TZ=UTC
KILL_SWITCH_AUTO_CLOSE=true
KILL_SWITCH_STATE_FILE=.state/kill_switch_state.json

# --- Safety switches -------------------------------------------------------- #
DRY_RUN=true
PAPER_MODE=false
LOG_LEVEL=INFO

# --- Paper mode only -------------------------------------------------------- #
PAPER_START_BALANCE=5000
PAPER_BASE_PRICES=BTCUSD:65000,ETHUSD:3200

# --- AI Co-Pilot (copilot_app.py) ------------------------------------------- #
# The co-pilot reads the LOCAL MetaTrader 5 terminal via the free `MetaTrader5`
# package - no token, no cloud, no API key. Run it on Windows with MT5 open:
#     streamlit run the5ers_bot/copilot_app.py
#
# Data source: native MT5 (mt5.initialize()). Watchlist: EURUSD, GBPUSD, USDJPY, XAUUSD.
# Risk model: 1R = $10 on a $5,000 demo (scaling to $20,000), RRR >= 1:1.5, max 3 trades/day,
#             circuit breaker -$20 (2R), hard kill-switch -$30 (3R), +$20 daily target.
#
# The Sentinel Council's LLM layer is OPTIONAL and only used for the
# "Consult Sentinel Council" button. Leave blank to run on the deterministic
# Risk Auditor alone (it fails open and never blocks the dashboard).
GROQ_API_KEY=
GEMINI_API_KEY=
# Optional: point at a specific terminal install / account (leave blank to use
# the running, already-logged-in terminal).
COPILOT_MT5_PATH=
COPILOT_MT5_LOGIN=
COPILOT_MT5_SERVER=
