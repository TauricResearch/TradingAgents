# --- TradingAgents core (see ../.env.example for the full list) ---
# At minimum you need an LLM provider key, e.g.:
# OPENAI_API_KEY=sk-...

# --- Webapp-specific ---
# SQLite file for accounts/jobs. Defaults to ~/.tradingagents/webapp.sqlite3
TRADINGAGENTS_WEBAPP_DB=

# Number of free analysis runs per user per calendar month
TRADINGAGENTS_FREE_TIER_LIMIT=5

# Hours a completed (ticker, trade_date) result is reused across all users
# instead of re-running the LLM pipeline. Cuts LLM spend on repeat/popular
# requests; 0 disables caching entirely.
TRADINGAGENTS_CACHE_TTL_HOURS=24

# --- Stripe billing (optional; leave blank to disable paid upgrades) ---
# Secret key from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
# Price ID for the recurring "Pro" subscription product
STRIPE_PRICE_ID=
# Signing secret for the /api/billing/webhook endpoint
STRIPE_WEBHOOK_SECRET=
