# Container for the media poller — a long-running (or scheduled) data collector
# that accumulates social/news history into a database for backtesting.
#
# Build:  docker build -f Dockerfile.poller -t tradingagents-poller .
# Run  :  docker run --rm -e MEDIA_POLLER_TICKERS=NVDA,AAPL \
#                     -e MEDIA_DB_URL=postgresql+psycopg://user:pass@host:5432/trading \
#                     tradingagents-poller
#
# The default ENTRYPOINT runs the hourly daemon. Override CMD for one-shot/cron
# (e.g. `--once`) or inspection (`--stats`).

FROM python:3.12-slim@sha256:646fb0bca3dd3ea1bcc6feb72c17ed16eed6e10cffc732fcc1478bd3e7f02d7b AS builder

ENV PYTHONDONTWRITEBYTECODE=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

WORKDIR /build
COPY . .
# Install with the [poller] extra so networked stores (Postgres, …) work.
RUN pip install --no-cache-dir --require-hashes -r constraints-poller.txt \
 && pip install --no-cache-dir --no-deps --no-build-isolation ".[poller]"

FROM python:3.12-slim@sha256:646fb0bca3dd3ea1bcc6feb72c17ed16eed6e10cffc732fcc1478bd3e7f02d7b

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

COPY --from=builder /opt/venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

RUN useradd --create-home appuser \
 && install -d -m 0755 -o appuser -g appuser /home/appuser/.tradingagents
USER appuser
WORKDIR /home/appuser/app

ENTRYPOINT ["tradingagents-poller"]
# Optional ticker sources use MEDIA_POLLER_TICKERS; global-only mode needs none.
CMD []
