# LLM Providers (set the one you use)
OPENAI_API_KEY=
GOOGLE_API_KEY=
# Optional: crypto train mode can rotate 4 Gemini accounts.
# Comma-separated, e.g. key1,key2,key3,key4. Raw keys are never written to the rotation state file.
GOOGLE_API_KEYS=
ANTHROPIC_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
ZHIPU_API_KEY=
OPENROUTER_API_KEY=

# Custom LLM gateway (optional). If set, overrides provider default endpoint.
LLM_BACKEND_URL=

# LLM model/provider selection (optional). Fallback to default_config.py when empty.
LLM_PROVIDER=
DEEP_THINK_LLM=
QUICK_THINK_LLM=

# GitHub Integration (for MCP server)
GITHUB_PERSONAL_ACCESS_TOKEN=

# Data Providers
FRED_API_KEY=

# Crypto train mode (optional)
TRADINGAGENTS_CRYPTO_MEMORY_DIR=
TRADINGAGENTS_GOOGLE_ROTATION_STATE=
