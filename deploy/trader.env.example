# Settings for the paper trader. Add them to the repo's .env, which is gitignored.

# Where the ledger, memory log, results and cache live. Default: ~/.tradingagents/trader
# TRADER_HOME=

# Paper capital in USDT, read once by `python -m trader init`.
TRADER_CAPITAL=

# Prices of the deep and quick models set in .env: "input,output" in USD per million tokens.
TRADER_PRICE_DEEP=
TRADER_PRICE_QUICK=

# Telegram bot (create one with @BotFather). Without them, messages only go to the log.
TRADER_TELEGRAM_TOKEN=
TRADER_TELEGRAM_CHAT_ID=
