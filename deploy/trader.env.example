# Settings for the paper trader. Add them to the repo's .env, which is gitignored.

# Where the ledger, memory log, results and cache live. Default: ~/.tradingagents/trader
# TRADER_HOME=

# Paper capital in USDT, read once by `python -m trader init`.
TRADER_CAPITAL=

# Prices of the deep and quick models set in .env: "input,output" in USD per million tokens.
TRADER_PRICE_DEEP=
TRADER_PRICE_QUICK=

# Telegram bot (create one with @BotFather). Without them, messages only go to the log.
TRADER_TELEGRAM_TOKEN=
TRADER_TELEGRAM_CHAT_ID=

# Write protection of the dashboard: with it set, POST /api/settings/llm (the model switch)
# must carry it as "Authorization: Bearer <token>"; the settings page asks for it. Without
# it anyone who reaches the API may switch the models. Any long random string, e.g.
# `openssl rand -hex 24`. Restart the web agent after changing it.
# TRADER_WEB_TOKEN=

# The demo account (ADR 0008): an API key made in OKX's *demo trading* area, with the
# trade permission only (no withdrawal). OKX accepts it on simulated trading only.
# Check it with `python -m trader demo check`.
# TRADER_OKX_DEMO_KEY=
# TRADER_OKX_DEMO_SECRET=
# TRADER_OKX_DEMO_PASSPHRASE=

# The live account (ADR 0010) trades real money, and its API key does NOT go in .env:
# every command and the dashboard load .env, and it gets copied between machines. The key
# is kept in a file of its own, on the machine that runs the live account only, and only
# the `live` commands read it:
#
#   ~/.config/tradingagents/okx-live.env      mode 600 (`chmod 600`), or live refuses to run
#
# with these three lines. Single quotes keep a # or a $ in a value as it is; a value with
# a blank, a line break or a non-ASCII character in it is refused:
#
#   TRADER_OKX_LIVE_KEY=
#   TRADER_OKX_LIVE_SECRET=
#   TRADER_OKX_LIVE_PASSPHRASE='...'
#
# Make the key under the sub-account that is the live account: read-only is enough for the
# shadow run; to unlock, the trade permission only (no withdrawal), bound to this machine's
# IP. Check it with `python -m trader live check`, which places nothing.
# To keep the file somewhere else, name its path here (the path: never the key itself).
# TRADER_OKX_LIVE_KEY_FILE=

# The live account's heartbeat (ADR 0010): the address ("ping URL") of a check made on an
# outside monitoring service, e.g. healthchecks.io, set to expect a beat every hour and to
# tell you once two hours pass without one. `python -m trader live run` requests it after
# each run that returns; without it there is no heartbeat. Whoever has the address can
# beat in the run's place, so keep it to this file: the logs name its host only.
# TRADER_LIVE_HEARTBEAT_URL=
