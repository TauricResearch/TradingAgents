# Settings for the paper trader. Add them to the repo's .env, which is gitignored.

# Where the ledger, memory log, results and cache live. Default: ~/.tradingagents/trader
# TRADER_HOME=

# Paper capital in USDT, read once by `python -m trader init`.
TRADER_CAPITAL=

# Prices of the deep and quick models set in .env: "input,output" in USD per million tokens.
TRADER_PRICE_DEEP=
TRADER_PRICE_QUICK=

# Telegram bot (create one with @BotFather). Without them, messages only go to the log.
TRADER_TELEGRAM_TOKEN=
TRADER_TELEGRAM_CHAT_ID=

# Write protection of the dashboard: with it set, POST /api/settings/llm (the model switch)
# must carry it as "Authorization: Bearer <token>"; the settings page asks for it. Without
# it anyone who reaches the API may switch the models. Any long random string, e.g.
# `openssl rand -hex 24`. Restart the web agent after changing it.
# TRADER_WEB_TOKEN=

# The demo account (ADR 0008): an API key made in OKX's *demo trading* area, with the
# trade permission only (no withdrawal). It only ever reaches simulated trading; the
# live account will use other variables. Check it with `python -m trader demo check`.
# TRADER_OKX_DEMO_KEY=
# TRADER_OKX_DEMO_SECRET=
# TRADER_OKX_DEMO_PASSPHRASE=
