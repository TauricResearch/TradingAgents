<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  launchd agent for the daily job on a Mac; the systemd units serve a Linux server.
  @REPO_DIR@ and @HOME@ are filled in at install time (see docs/roadmap.md).

  launchd fires calendar intervals in the Mac's local time, so the agent ticks every
  hour at :05 and runs the job only while the UTC hour is 00 to 06: the first tick after
  UTC midnight is the run, the later ones catch up a run that crashed. On a finished
  trade date a run does nothing. A tick missed while the Mac slept fires once on wake.
  launchd has no run-time limit, so a hung run blocks the later ticks of that day: a
  daily report that never arrives is the sign.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.tradingagents.trader.daily</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>-c</string>
    <string>case "$(date -u +%H)" in 0[0-6]) exec "@REPO_DIR@/.venv/bin/python" -m trader daily ;; esac</string>
  </array>
  <key>WorkingDirectory</key>
  <string>@REPO_DIR@</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>TZ</key>
    <string>UTC</string>
  </dict>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Minute</key>
    <integer>5</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>@HOME@/Library/Logs/trader/daily.log</string>
  <key>StandardErrorPath</key>
  <string>@HOME@/Library/Logs/trader/daily.log</string>
</dict>
</plist>
